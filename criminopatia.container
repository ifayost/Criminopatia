[Unit]
Description=Criminopatia Podcast Downloader
Documentation=https://github.com/ifayost/Criminopatia

[Container]
Image=criminopatia
ContainerName=criminopatia
AutoUpdate=local

# Reemplaza USER con tu nombre de usuario real
Volume=/home/USER/Criminopatia:/Criminopatia:Z

# Opción A: Podman secrets (más seguro)
Secret=CRIMINOPATIA_USER:env
Secret=CRIMINOPATIA_PASSWORD:env

# Opción B: Archivo .env (menos seguro pero más sencillo)
# EnvironmentFile=/home/USER/.config/containers/systemd/criminopatia.env

# Modos de ejecución (descomentar según necesites)
# Environment=RUN_EPISODES=true
# Environment=RUN_CF=true
# Environment=RUN_ARCHIVO=true

[Install]
WantedBy=default.target
